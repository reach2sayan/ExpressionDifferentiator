diff --git a/include/nwgraph/containers/soa_apply.hpp b/include/nwgraph/containers/soa_apply.hpp
new file mode 100644
index 0000000..f34b572
--- /dev/null
+++ b/include/nwgraph/containers/soa_apply.hpp
@@ -0,0 +1,17 @@
+#ifndef NW_GRAPH_SOA_APPLY_HPP
+#define NW_GRAPH_SOA_APPLY_HPP
+#include <tuple>
+#include <type_traits>
+#include <utility>
+namespace nw::graph {
+template <class... Ts> constexpr std::tuple<Ts...>& tuple_base(std::tuple<Ts...>& t) { return t; }
+template <class... Ts> constexpr const std::tuple<Ts...>& tuple_base(const std::tuple<Ts...>& t) { return t; }
+template <class... Ts> constexpr std::tuple<Ts...>&& tuple_base(std::tuple<Ts...>&& t) { return std::move(t); }
+// P2165R4 constrained std::apply on __tuple_like, which excludes classes derived
+// from std::tuple; soa containers are exactly that, so slice to the base first.
+template <class F, class T>
+constexpr decltype(auto) soa_apply(F&& f, T&& t) {
+  return std::apply(std::forward<F>(f), tuple_base(std::forward<T>(t)));
+}
+} // namespace nw::graph
+#endif
